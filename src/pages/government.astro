import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import CTA from '../components/CTA.astro';import Arrow from '../components/Arrow.astro';
---
<Layout title="Government file protection"><PageHero eyebrow="FOR GOVERNMENT" title="Mission data deserves its own line of defense." text="Explore a file-centric approach to protecting sensitive information, with an evaluation grounded in your mission, policies and deployment requirements." number="03"><a class="button button-dark" href="/request-demo?interest=Government">Start a mission-focused discussion <Arrow/></a></PageHero>
<section class="container section split-content"><div><span class="eyebrow">PROTECTION CLOSE TO THE INFORMATION</span><h2>Start with the data.<br/>Respect the mission.</h2></div><div><p class="large-copy">Access to infrastructure and permission to read a sensitive file are different decisions.</p><p>Cyber Reliant’s described architecture combines file fragmentation, encryption, distribution and application-level controls. The Windows file-system filter participates in the protection and reconstruction process.</p><p>For the upcoming network version, the design extends to HSM-based key architecture and multiple logical storage locations.</p><a class="text-link" href="/technology">Examine the architecture <Arrow/></a></div></section>
<section class="dark-section"><div class="section container"><span class="eyebrow">EVALUATE WITH PRECISION</span><h2>Evidence before assumptions.</h2><div class="use-case-grid"><article><span class="card-number">01 / MISSION FIT</span><h3>Define the environment.</h3><p>Document data sensitivity, connected or constrained operating conditions, approved applications and storage boundaries.</p></article><article><span class="card-number">02 / TECHNICAL ASSURANCE</span><h3>Examine the implementation.</h3><p>Request product-specific cryptographic details, key-lifecycle documentation, access-control behavior and test evidence.</p></article><article><span class="card-number">03 / ACQUISITION</span><h3>Verify the requirements.</h3><p>Confirm availability, support, procurement eligibility and any validation requirements with the product team.</p></article></div></div></section>
<section class="section container split-content"><div><span class="eyebrow">A CLEAR BASIS FOR DISCUSSION</span><h2>Your requirements<br/>set the standard.</h2></div><div class="assurance-note"><h3>No implied accreditation.</h3><p>This site does not claim FIPS validation, FedRAMP authorization, approval for classified use, a government contract vehicle or agency endorsement.</p><p>Suitability for any regulated or government use must be established through evidence for the specific product, version and deployment.</p><a class="text-link" href="/request-demo?interest=Government">Discuss your assurance requirements <Arrow/></a></div></section><CTA title="Put your mission requirements on the table." text="Explore the architecture, identify the evidence you need and define a focused evaluation."/></Layout>
