---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
const steps=[
{id:'fragment',title:'Fragment the file.',label:'Fragment',text:'Cyber Reliant divides the sensitive file into fragments. Protection starts with the pieces, and access depends on bringing the correct pieces back together.',detail:'Fragmentation is combined with encryption; dividing the file alone is not cryptographic protection.',input:'SENSITIVE FILE',output:'FILE FRAGMENTS'},
{id:'encrypt',title:'Encrypt the fragments.',label:'Encrypt',text:'The file fragments are encrypted before distribution. Possessing those protected pieces is not the same as possessing a readable file.',detail:'Encryption algorithms, integrity controls and fragment dependencies belong in the implementation review.',input:'FILE FRAGMENTS',output:'ENCRYPTED FRAGMENTS'},
{id:'separate',title:'Separate the data and key paths.',label:'Separate',text:'Protected file fragments are distributed across storage locations. Cryptographic material is protected through a separate path, so storage access alone does not provide everything required for reconstruction.',detail:'The upcoming network design also fragments/shreds the cryptographic material and protects multiple components through the HSM architecture. Logical locations do not necessarily create physically independent failure domains.',input:'SEPARATE PROTECTION PATHS',output:'FILE FRAGMENTS + PROTECTED CRYPTOGRAPHIC MATERIAL'},
{id:'reconstruct',title:'Rebuild through authorized access.',label:'Reconstruct',text:'The authorized Cyber Reliant path brings the required fragments and cryptographic material together, decrypts the fragments and reconstructs readable data.',detail:'The Windows filter participates in identifying the correct fragments, obtaining required cryptographic material, decryption and reconstruction. Evaluate access checks and readable-data handling for your workflows.',input:'REQUIRED FRAGMENTS + CRYPTOGRAPHIC MATERIAL',output:'AUTHORIZED CYBER RELIANT RECONSTRUCTION'}];
---
<Layout title="How it works"><PageHero eyebrow="HOW IT WORKS" title="A file. Reconsidered." text="Fragment. Encrypt. Separate. Reconstruct. A readable file depends on the authorized Cyber Reliant path—not storage access alone." number="01"/>
<section class="container section walkthrough" aria-label="File protection walkthrough"><div class="walkthrough-nav" aria-label="Protection steps">{steps.map((s,i)=><a href={`#${s.id}`} class:list={['step-link',{active:i===0}]} data-step={s.id} aria-current={i===0?'step':undefined}><span>0{i+1}</span>{s.label}<span aria-hidden="true"><svg class="diagonal-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5"/></svg></span></a>)}</div><div class="step-panels">{steps.map((s,i)=><article id={s.id} class:list={['step-panel',{active:i===0}]}>{s.id==='separate' && <span id="distribute" class="anchor-alias" aria-hidden="true"></span>}<div class="step-copy"><span class="eyebrow">STEP 0{i+1} / 04</span><h2>{s.title}</h2><p class="large-copy">{s.text}</p><p class="step-detail">{s.detail}</p></div><div class:list={['step-art',`step-art-${i}`]} role="img" aria-label={`${s.input} becomes ${s.output}`}><span class="tiny-label">{s.input}</span><div class="step-art-content">{i===0?<><div class="art-file">▤</div><span class="art-arrow">→</span><div class="tile-matrix">{Array.from({length:9},()=> <i></i>)}</div></>:i===1?<><div class="tile-matrix">{Array.from({length:9},()=> <i></i>)}</div><span class="art-arrow">→</span><div class="cipher-matrix">{['A7','F2','9C','3E','B8','D1','6F','2A','E4'].map(t=><i>{t}</i>)}</div></>:i===2?<div class="separation-art"><div><span class="separation-label">FILE PATH</span><div class="three-stores">{['A','B','C'].map(t=><div><span>▥</span><b>{t}</b></div>)}</div></div><div class="separated-key"><span class="separation-label">KEY PATH</span><span aria-hidden="true">◇</span><small>Protected cryptographic<br/>material</small></div></div>:<><div class="reconstruct-inputs"><span>▤ + ◇</span><small>Required fragments<br/>+ cryptographic material</small></div><span class="art-arrow">→</span><div class="art-file">▤<small>AUTHORIZED</small></div></>}</div><span class="tiny-label">{s.output}</span><small>Conceptual illustration</small></div></article>)}</div></section>
<section class="dark-section"><div class="container section app-demo-grid"><div><span class="eyebrow">THE ACCESS DECISION</span><h2>Which application<br/>is asking?</h2><p>Application policy controls entry to the reconstruction path. The permitted path brings together the correct fragments and required cryptographic material to rebuild the file.</p><div class="segmented" role="group" aria-label="Application access example"><button class="selected" data-app="allowed" aria-pressed="true">Authorized app</button><button data-app="blocked" aria-pressed="false">Unapproved app</button></div></div><div class="access-demo" aria-live="polite"><div class="demo-request"><span class="app-symbol">▦</span><span id="app-name">Authorized application</span></div><div class="demo-connector"></div><div class="demo-policy">APPLICATION POLICY <span id="policy-result">ALLOWED</span></div><div class="demo-connector"></div><div class="demo-result"><span id="access-icon">▤</span><strong id="access-title">Controlled file access</strong><p id="access-description">The permitted application enters the Cyber Reliant path for fragment identification, cryptographic material, decryption and reconstruction.</p></div><small>Illustrative policy decision, not a live security demonstration.</small></div></div></section>
<section class="section container faq-section"><div><span class="eyebrow">A FEW IMPORTANT DISTINCTIONS</span><h2>More layers.<br/>Clear boundaries.</h2></div><div class="faq-list"><details><summary>Is fragmentation the same as encryption?</summary><p>No. Fragmentation divides data into pieces. Encryption protects the contents using cryptography. Cyber Reliant combines these with separate protection of cryptographic material and authorized reconstruction.</p></details><details><summary>Does this replace backups or endpoint security?</summary><p>No. File confidentiality, recovery and endpoint protection address different parts of the threat model. Retain your backup, recovery, identity and endpoint controls as part of a layered security program.</p></details><details><summary>Does distribution guarantee availability?</summary><p>No. Availability depends on the storage design, fragment dependencies, key recovery and operating conditions. Evaluate failure scenarios and recovery procedures for the intended deployment.</p></details><details><summary>What is different about the upcoming network version?</summary><p>The upcoming network design fragments or shreds cryptographic material itself and protects multiple key components through the HSM architecture. This key path is separate from the encrypted file fragments distributed across logical storage locations. The paths meet through authorized reconstruction. Confirm availability, integrations and key-component lifecycle details during evaluation.</p></details><details><summary>Can a replacement file-system driver simply open the file?</summary><p>Replacing or bypassing a conventional driver does not, by itself, reproduce Cyber Reliant’s identification, key-material access, decryption and reconstruction process. A malicious filter may reach protected storage without automatically obtaining the information and processes needed to rebuild the file. This is not a claim that bypass or kernel-level attacks are impossible. <a href="/technology#attacker-path">Explore the attacker path.</a></p></details><details><summary>Does separation guarantee that data or keys can never be compromised?</summary><p>No. The distinction is that storage compromise alone does not supply the complete reconstruction path. Security depends on implementation, configuration and the threat model, including cryptographic-material exposure and readable data in use. Logical storage locations are not necessarily physically independent failure domains.</p></details></div></section><CTA title="See the process against your use case."/>
<script>
const steps=document.querySelectorAll<HTMLAnchorElement>('[data-step]');
const panels=document.querySelectorAll<HTMLElement>('.step-panel');
function selectStep(id:string){if(id==='distribute')id='separate';if(!Array.from(panels).some(p=>p.id===id))return;steps.forEach(s=>{const active=s.dataset.step===id;s.classList.toggle('active',active);if(active)s.setAttribute('aria-current','step');else s.removeAttribute('aria-current');});panels.forEach(p=>{p.classList.toggle('active',p.id===id);p.hidden=p.id!==id;});}
selectStep(location.hash.slice(1)||'fragment');
steps.forEach(s=>s.addEventListener('click',e=>{e.preventDefault();const id=s.dataset.step!;selectStep(id);history.pushState(null,'',`#${id}`);}));
window.addEventListener('popstate',()=>selectStep(location.hash.slice(1)||'fragment'));
document.querySelectorAll<HTMLButtonElement>('[data-app]').forEach(b=>b.addEventListener('click',()=>{const allowed=b.dataset.app==='allowed';document.querySelectorAll('[data-app]').forEach(el=>{el.classList.toggle('selected',el===b);el.setAttribute('aria-pressed',String(el===b));});document.querySelector('.access-demo')?.classList.toggle('is-blocked',!allowed);document.querySelector('#app-name')!.textContent=allowed?'Authorized application':'Unapproved application';document.querySelector('#policy-result')!.textContent=allowed?'ALLOWED':'BLOCKED';document.querySelector('#access-icon')!.textContent=allowed?'▤':'×';document.querySelector('#access-title')!.textContent=allowed?'Controlled file access':'File access denied';document.querySelector('#access-description')!.textContent=allowed?'The permitted application enters the Cyber Reliant path for fragment identification, cryptographic material, decryption and reconstruction.':'The application is outside the allow-list and does not proceed to reconstruction.';}));
</script></Layout>
