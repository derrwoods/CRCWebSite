---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
const steps=[
{id:'fragment',title:'Fragment the file.',label:'Fragment',text:'The protection process divides a file into fragments. Fragmentation is one layer in a coordinated design; it is not a substitute for encryption.',detail:'A sensitive file becomes pieces that move through the protection workflow.',input:'SENSITIVE FILE',output:'FILE FRAGMENTS'},
{id:'encrypt',title:'Encrypt the fragments.',label:'Encrypt',text:'The fragments are encrypted, and cryptographic material is protected as part of the architecture. The goal is to separate possession of stored data from the ability to read it.',detail:'Fragment encryption and key protection work together. Specific algorithms and key-lifecycle details belong in the technical evaluation.',input:'FILE FRAGMENTS',output:'ENCRYPTED FRAGMENTS'},
{id:'distribute',title:'Distribute protected data.',label:'Distribute',text:'Protected fragments are distributed across storage locations. The upcoming network version uses multiple logical storage locations and an HSM-based key architecture.',detail:'Logical separation does not automatically create independent failure domains. Storage permissions and deployment design still matter.',input:'ENCRYPTED FRAGMENTS',output:'LOGICAL LOCATIONS A / B / C'},
{id:'reconstruct',title:'Control the path back.',label:'Reconstruct',text:'Application-level controls govern protected file access. In the Windows implementation, a file-system filter participates in decryption and reconstruction.',detail:'Evaluate authorized applications, application identity checks, temporary data and failure behavior for your workflow.',input:'AUTHORIZED FILE ACCESS',output:'CONTROLLED RECONSTRUCTION'}];
---
<Layout title="How it works"><PageHero eyebrow="HOW IT WORKS" title="A file. Reconsidered." text="Protection is a process, not just a place to store data. Follow the path from a sensitive file to controlled reconstruction." number="01"/>
<section class="container section walkthrough" aria-label="File protection walkthrough"><div class="walkthrough-nav" aria-label="Protection steps">{steps.map((s,i)=><a href={`#${s.id}`} class:list={['step-link',{active:i===0}]} data-step={s.id} aria-current={i===0?'step':undefined}><span>0{i+1}</span>{s.label}<span aria-hidden="true"><svg class="diagonal-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5"/></svg></span></a>)}</div><div class="step-panels">{steps.map((s,i)=><article id={s.id} class:list={['step-panel',{active:i===0}]}><div class="step-copy"><span class="eyebrow">STEP 0{i+1} / 04</span><h2>{s.title}</h2><p class="large-copy">{s.text}</p><p>{s.detail}</p></div><div class:list={['step-art',`step-art-${i}`]} role="img" aria-label={`${s.input} becomes ${s.output}`}><span class="tiny-label">{s.input}</span><div class="step-art-content">{i===0?<><div class="art-file">▤</div><span class="art-arrow">→</span><div class="tile-matrix">{Array.from({length:9},()=> <i></i>)}</div></>:i===1?<><div class="tile-matrix">{Array.from({length:9},()=> <i></i>)}</div><span class="art-arrow">→</span><div class="cipher-matrix">{['A7','F2','9C','3E','B8','D1','6F','2A','E4'].map(t=><i>{t}</i>)}</div></>:i===2?<div class="three-stores">{['A','B','C'].map(t=><div><span>▥</span><b>{t}</b></div>)}</div>:<><div class="art-file key-file">◇</div><span class="art-arrow">→</span><div class="art-file">▤<small>AUTHORIZED</small></div></>}</div><span class="tiny-label">{s.output}</span><small>Conceptual illustration</small></div></article>)}</div></section>
<section class="dark-section"><div class="container section app-demo-grid"><div><span class="eyebrow">THE ACCESS DECISION</span><h2>Which application<br/>is asking?</h2><p>Application allow-listing brings the requesting application into the file-access decision. Explore the conceptual difference between an allowed application and one outside the policy.</p><div class="segmented" role="group" aria-label="Application access example"><button class="selected" data-app="allowed" aria-pressed="true">Authorized app</button><button data-app="blocked" aria-pressed="false">Unapproved app</button></div></div><div class="access-demo" aria-live="polite"><div class="demo-request"><span class="app-symbol">▦</span><span id="app-name">Authorized application</span></div><div class="demo-connector"></div><div class="demo-policy">APPLICATION POLICY <span id="policy-result">ALLOWED</span></div><div class="demo-connector"></div><div class="demo-result"><span id="access-icon">▤</span><strong id="access-title">Controlled file access</strong><p id="access-description">The permitted application proceeds through the protected access path.</p></div><small>Illustrative policy decision, not a live security demonstration.</small></div></div></section>
<section class="section container faq-section"><div><span class="eyebrow">A FEW IMPORTANT DISTINCTIONS</span><h2>More layers.<br/>Clear boundaries.</h2></div><div class="faq-list"><details open><summary>Is fragmentation the same as encryption?</summary><p>No. Fragmentation divides data into pieces. Encryption protects the contents using cryptography. Cyber Reliant’s described approach combines these with distribution, key protection and application-level controls.</p></details><details><summary>Does this replace backups or endpoint security?</summary><p>No. File confidentiality, recovery and endpoint protection address different parts of the threat model. Retain your backup, recovery, identity and endpoint controls as part of a layered security program.</p></details><details><summary>Does distribution guarantee availability?</summary><p>No. Availability depends on the storage design, fragment dependencies, key recovery and operating conditions. Evaluate failure scenarios and recovery procedures for the intended deployment.</p></details><details><summary>What is different about the upcoming network version?</summary><p>The planned network design uses an HSM-based key architecture and distributes protected fragments across multiple logical storage locations. Confirm availability, supported integrations and implementation details during evaluation.</p></details></div></section><CTA title="See the process against your use case."/>
<script>
const steps=document.querySelectorAll<HTMLAnchorElement>('[data-step]');
const panels=document.querySelectorAll<HTMLElement>('.step-panel');
function selectStep(id:string){if(!Array.from(panels).some(p=>p.id===id))return;steps.forEach(s=>{const active=s.dataset.step===id;s.classList.toggle('active',active);if(active)s.setAttribute('aria-current','step');else s.removeAttribute('aria-current');});panels.forEach(p=>{p.classList.toggle('active',p.id===id);p.hidden=p.id!==id;});}
selectStep(location.hash.slice(1)||'fragment');
steps.forEach(s=>s.addEventListener('click',e=>{e.preventDefault();const id=s.dataset.step!;selectStep(id);history.pushState(null,'',`#${id}`);}));
window.addEventListener('popstate',()=>selectStep(location.hash.slice(1)||'fragment'));
document.querySelectorAll<HTMLButtonElement>('[data-app]').forEach(b=>b.addEventListener('click',()=>{const allowed=b.dataset.app==='allowed';document.querySelectorAll('[data-app]').forEach(el=>{el.classList.toggle('selected',el===b);el.setAttribute('aria-pressed',String(el===b));});document.querySelector('.access-demo')?.classList.toggle('is-blocked',!allowed);document.querySelector('#app-name')!.textContent=allowed?'Authorized application':'Unapproved application';document.querySelector('#policy-result')!.textContent=allowed?'ALLOWED':'BLOCKED';document.querySelector('#access-icon')!.textContent=allowed?'▤':'×';document.querySelector('#access-title')!.textContent=allowed?'Controlled file access':'File access denied';document.querySelector('#access-description')!.textContent=allowed?'The permitted application proceeds through the protected access path.':'The application is outside the allow-list and does not proceed to reconstruction.';}));
</script></Layout>
