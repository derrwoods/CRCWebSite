---
import Arrow from './Arrow.astro';
const { title = 'Start with your most sensitive files.', text = 'Let’s explore where file-level protection fits in your security architecture.' } = Astro.props;
---
<section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow">A more resilient starting point</span><h2>{title}</h2><p>{text}</p></div><a class="button button-dark" href="/request-demo">Request a demo <Arrow /></a></div></section>
