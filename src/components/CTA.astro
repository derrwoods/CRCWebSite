---
import Arrow from './Arrow.astro';
const { title = 'Start with your most sensitive files.', text = 'Let’s explore where file-level protection fits in your security architecture.', government = false } = Astro.props;
---
<section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow">A more resilient starting point</span><h2>{title}</h2><p>{text}</p></div><a class="button button-dark" href={government ? "/request-demo?interest=Government" : "/request-demo"}>{government ? "Request a briefing" : "Request a demo"} <Arrow /></a></div></section>
