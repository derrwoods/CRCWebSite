---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '@fontsource/noto-sans-symbols-2/400.css';
import Logo from '../components/Logo.astro';
import Arrow from '../components/Arrow.astro';
interface Props { title: string; description?: string; }
const {title, description = 'Storage access is not file access. Cyber Reliant separates protected file fragments from cryptographic material and controls the path to readable reconstruction.'} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const government = path === '/government' || (path === '/request-demo' && Astro.url.searchParams.get('interest') === 'Government');
const contactHref = government ? '/request-demo?interest=Government' : '/request-demo';
const contactLabel = government ? 'Request a briefing' : 'Request a demo';
const links = [['How it works','/how-it-works'],['Enterprise','/enterprise'],['Government','/government'],['Technology','/technology'],['About','/about']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="robots" content="noindex, nofollow"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#142d28"/><meta property="og:title" content={`${title} | Cyber Reliant`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title} | Cyber Reliant</title></head><body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="announcement"><div class="container"><span class="announcement-tag">ON THE HORIZON</span><span>Separate file and key paths. Authorized reconstruction.</span><a href="/technology#network">Explore what’s next <span aria-hidden="true"><svg class="diagonal-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5"/></svg></span></a></div></div>
<header class="site-header"><div class="container nav-wrap"><Logo/><button class="menu-toggle" aria-expanded="false" aria-controls="main-navigation" aria-label="Open navigation"><span></span><span></span></button><nav id="main-navigation" aria-label="Main navigation">{links.map(([label,href])=><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}<a class="button button-dark nav-cta" href={contactHref} aria-current={path === '/request-demo' ? 'page' : undefined}>{contactLabel} <Arrow/></a></nav></div></header>
<main id="main"><slot/></main>
<footer class="footer"><div class="container"><div class="footer-main"><div class="footer-brand"><Logo/><p>Protection that stays<br/>with the file.</p><span class="footer-caption">Fragment. Encrypt. Separate. Reconstruct.</span></div><div><h2>Explore</h2><a href="/how-it-works">How it works</a><a href="/technology">Technology</a><a href="/about">About Cyber Reliant</a></div><div><h2>Built for your mission</h2><a href="/enterprise">Enterprise</a><a href="/government">Government</a><a href={contactHref}>{contactLabel} <span aria-hidden="true"><svg class="diagonal-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5"/></svg></span></a></div><div class="footer-note"><span class="tiny-label">THE NEXT CONVERSATION</span><p>Bring your architecture.<br/>We’ll start with the files.</p><a class="text-link" href={contactHref}>{government ? "Request a briefing" : "Let’s talk"} <Arrow/></a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Cyber Reliant. All rights reserved.</span><span>Designed around the data.</span><a href={`${contactHref}#privacy`}>Request privacy</a></div></div></footer>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
const nav = document.querySelector<HTMLElement>('#main-navigation');
function closeMenu(){ toggle?.setAttribute('aria-expanded','false'); toggle?.setAttribute('aria-label','Open navigation'); nav?.classList.remove('is-open'); }
toggle?.addEventListener('click',()=>{ const open=toggle.getAttribute('aria-expanded')!=='true'; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',open?'Close navigation':'Open navigation'); nav?.classList.toggle('is-open',open); });
document.addEventListener('keydown',e=>{if(e.key==='Escape' && toggle?.getAttribute('aria-expanded')==='true'){closeMenu();toggle?.focus();}});
document.addEventListener('click',e=>{if(e.target instanceof Node && !nav?.contains(e.target) && !toggle?.contains(e.target))closeMenu();});
</script>
</body></html>
